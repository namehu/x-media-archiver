DATABASE_URL=postgresql://xarchiver:xarchiver_dev_password@postgres:5432/xarchiver
ARCHIVE_DIR=/app/archive
COOKIE_FILE=/app/secrets/cookies.txt
DEFAULT_DOWNLOAD_ENGINE=gallery-dl
RETRY_LIMIT=3
RETRY_BACKOFF_MINUTES=15
STUCK_TIMEOUT_MINUTES=120
QUEUE_BATCH_SIZE=20
DOWNLOADER_SLEEP_MIN_SECONDS=0
DOWNLOADER_SLEEP_MAX_SECONDS=3
DOWNLOADER_PROGRESS_FALLBACK_INTERVAL_SECONDS=10
SOURCE_SCAN_BATCH_SIZE=20
SOURCE_SCAN_SLEEP_MIN_SECONDS=0
SOURCE_SCAN_SLEEP_MAX_SECONDS=3
SOURCE_SCAN_HTTP_TIMEOUT_SECONDS=15
SOURCE_SCAN_HTTP_RETRIES=2
OPERATION_LOG_MAX_BYTES=10485760
API_HOST=0.0.0.0
API_PORT=18000
AUTH_MODE=password
# auto follows the effective request scheme after trusted proxy headers are applied.
AUTH_COOKIE_SECURE=auto
# Comma-separated proxy IPs trusted by Uvicorn; direct local development needs loopback only.
FORWARDED_ALLOW_IPS=127.0.0.1
AUTH_SESSION_TTL_HOURS=168
RUNTIME_WS_ENABLED=true
