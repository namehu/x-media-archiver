# Production environment for docker-compose.prod.yml.
# Copy to .env.production and edit. This file is git-ignored (.env.* except .env.example).

# --- Bundled Postgres (default) ---------------------------------------------
# These are consumed by the `postgres` service. Use a strong password.
POSTGRES_DB=xarchiver
POSTGRES_USER=xarchiver
POSTGRES_PASSWORD=change_me_strong_password

# DATABASE_URL is consumed by the app. For the bundled Postgres above, the host
# is the compose service name `postgres`. Keep credentials in sync with the
# POSTGRES_* values. URL-encode any special characters in the password.
DATABASE_URL=postgresql://xarchiver:change_me_strong_password@postgres:5432/xarchiver

# --- External Postgres (e.g. Supabase) — alternative ------------------------
# To use an external database instead, set DATABASE_URL below, then remove the
# `postgres` service and `depends_on` block in docker-compose.prod.yml.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Application paths (container-internal; leave as-is) ---------------------
ARCHIVE_DIR=/app/archive
COOKIE_FILE=/app/secrets/cookies.txt

# --- Download / retry tuning -------------------------------------------------
DEFAULT_DOWNLOAD_ENGINE=gallery-dl
RETRY_LIMIT=3
RETRY_BACKOFF_MINUTES=15
STUCK_TIMEOUT_MINUTES=120
QUEUE_BATCH_SIZE=20
DOWNLOADER_SLEEP_MIN_SECONDS=2
DOWNLOADER_SLEEP_MAX_SECONDS=6

# --- Source scanning (independent of downloads) ------------------------------
SOURCE_SCAN_BATCH_SIZE=20
SOURCE_SCAN_SLEEP_MIN_SECONDS=2
SOURCE_SCAN_SLEEP_MAX_SECONDS=6

# --- Operation logs ----------------------------------------------------------
# Per task log stream size limit. Detailed logs are JSONL files under ARCHIVE_DIR/logs/.
OPERATION_LOG_MAX_BYTES=10485760

# --- API server --------------------------------------------------------------
# The API listens on port 18000 both inside the production container and on the
# published host interface.
API_PORT=18000
# Trust loopback plus the Docker subnet used by this Compose project. Confirm the
# deployed subnet with `docker network inspect` and replace 172.18.0.0/16 when it
# differs. The optional Traefik override is separate because its container IP is dynamic.
FORWARDED_ALLOW_IPS=127.0.0.1,172.18.0.0/16

# --- Web/API authentication -------------------------------------------------
# Authentication is enabled by default. On first start, read the one-time setup
# token from the app container log and finish administrator setup in the WebUI.
AUTH_MODE=password
# Generic production deployments force Secure even if proxy headers are
# misconfigured. The optional Traefik mixed HTTP/HTTPS override uses auto.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_HOURS=168
RUNTIME_WS_ENABLED=true

# --- Optional Traefik routing (docker-compose.traefik.yml) ------------------
TRAEFIK_NETWORK=traefik
TRAEFIK_FORWARDED_ALLOW_IPS=*
TRAEFIK_AUTH_COOKIE_SECURE=auto
TRAEFIK_WEB_ENTRYPOINT=web
TRAEFIK_WEBSECURE_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
XMA_PUBLIC_HOST=archive.example.com
XMA_LAN_HOST=192.168.1.10
XMA_LAN_CIDR=192.168.1.0/24
